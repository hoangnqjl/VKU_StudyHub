# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=vku_studyhub_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration (Aiven MySQL / Local MySQL)
DB_HOST=mysql-vku-studyhub.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your_aiven_mysql_password
DB_NAME=defaultdb
DB_SSL=true

# Client URL (Expo / Frontend)
CLIENT_URL=*
